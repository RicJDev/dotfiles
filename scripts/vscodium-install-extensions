#!/usr/bin/env bash

set -e

EXT_FILE="${1:-$HOME/.dotfiles/vscodium/extensions.txt}"

if [[ ! -f "$EXT_FILE" ]]; then
    echo "File not found: $EXT_FILE"
    exit 1
fi

echo "Installing extensions from $EXT_FILE..."

while read -r ext; do
    [[ -z "$ext" || "$ext" =~ ^# ]] && continue
    echo "Installing: $ext"
    codium --install-extension "$ext" --force
done < "$EXT_FILE"

echo "Extensions installed successfully."
